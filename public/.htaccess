Options -Indexes
DirectoryIndex index.php

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://surrentech.com%{REQUEST_URI} [R=301,L]

RewriteRule ^\.well-known/ - [L]
RewriteRule ^assets/[a-zA-Z0-9_-]+\.png$ - [L]
RewriteRule ^(?:index\.php)?$ index.php [L]
RewriteRule ^(?:healthz|consult|manage-console(?:/.*)?)$ index.php [QSA,L]
RewriteRule ^ - [R=404,L]

<FilesMatch "(^\.|\.(?:py|sqlite3?|log|gz|ini|env)$|^(?:home|app)\.php$)">
  Require all denied
</FilesMatch>

<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
