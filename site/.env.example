# Copy to .env on the server (upload via FTP). Never commit the real .env.
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=surrentech.com,www.surrentech.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://surrentech.com,https://www.surrentech.com
DJANGO_DB_PATH=/home/surrente/surrentech_site.sqlite3
RUN_MIGRATIONS_ON_START=1
# First boot only: creates the admin login if no superuser exists yet.
# Remove both lines afterwards.
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=
